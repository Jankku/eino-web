{
  "name": "eino-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "prebuild": "license-checker --production --json --excludePrivatePackages --customPath licenses-format.json --out licenses.json",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint ./src",
    "lint:fix": "oxlint --fix ./src",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ericblade/quagga2": "^1.13.0",
    "@hookform/resolvers": "^7.0.5",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@tanstack/react-query": "^5.107.1",
    "@uidotdev/usehooks": "^2.4.1",
    "cropperjs": "^2.3.1",
    "diff": "^9.0.0",
    "jwt-decode": "^4.0.0",
    "ky": "^2.2.0",
    "luxon": "^3.7.2",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "license-checker": "^25.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.7",
    "vite-plugin-checker": "^1.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "sharp@0.34.5": true
  }
}
